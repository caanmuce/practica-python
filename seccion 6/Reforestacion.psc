Algoritmo Reforestacion
	Definir area, pinos, oyameles, cedros Como Real
	
    area <- 10000
	
    pinos <- (area / 10) * 8
    oyameles <- (area / 15) * 15
    cedros <- (area / 18) * 10
	
    Escribir "Cantidad de pinos: ", pinos
    Escribir "Cantidad de oyameles: ", oyameles
    Escribir "Cantidad de cedros: ", cedros
FinAlgoritmo
